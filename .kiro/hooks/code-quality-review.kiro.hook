{
  "enabled": true,
  "name": "Code Quality Reviewer",
  "description": "Analyzes modified source code files for potential improvements including code smells, design patterns, best practices, readability, maintainability, and performance optimizations",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.js",
      "src/**/*.jsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source code file was just modified. Please analyze the changes for potential improvements. Look for:\n- Code smells (duplicated code, long methods, large classes, etc.)\n- Design pattern opportunities or violations\n- Best practices for the language/framework in use\n- Readability improvements (naming, structure, comments)\n- Maintainability concerns (coupling, cohesion, modularity)\n- Performance optimizations\n\nProvide actionable, specific suggestions while ensuring existing functionality is preserved. Be concise and prioritize the most impactful improvements."
  }
}